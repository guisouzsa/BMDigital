# Domínio oficial do site (obrigatório em produção).
# Usado em canonical, Open Graph, sitemap.xml, robots.txt e dados estruturados.
# Se não for definido, o padrão é https://bmdigitalon-iota.vercel.app (src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://bmdigitalon-iota.vercel.app

# Google Search Console: o código atual já está em src/lib/site.ts.
# Use esta variável só se precisar trocar o código sem mexer no código-fonte.
GOOGLE_SITE_VERIFICATION=

# Rastreamento: cada tag só é carregada se a variável estiver preenchida
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
